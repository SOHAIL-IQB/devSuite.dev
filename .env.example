# DevSuite Production Environment Configuration
# Copy this file to .env and fill in the values before running docker-compose up -d

# --------------------------
# Database Configuration
# --------------------------
DB_USER=devsuite
DB_PASSWORD=your_secure_db_password
DB_NAME=devsuite

# --------------------------
# Security & JWT
# --------------------------
# Generate a strong, random 64-character string for production
JWT_SECRET=replace_this_with_a_secure_jwt_secret_in_production

# --------------------------
# Networking
# --------------------------
# The public URL where the frontend is accessible (used for CORS and cookies)
FRONTEND_URL=https://devsuite.yourdomain.com
# The port exposed by the Nginx reverse proxy
PORT=80
